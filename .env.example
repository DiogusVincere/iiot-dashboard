# Copie para .env e preencha. O .env fica fora do git.

# Contentful: painel do space > Settings > API keys
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ENVIRONMENT=
VITE_CONTENTFUL_BASE_ENDPOINT=
VITE_CONTENTFUL_CDN_TOKEN=
# Personal access token (comeca com CFPAT), usado para criar e publicar manutencoes
VITE_CONTENTFUL_API_TOKEN=

# Qubitro: portal > API keys (usado em src/services/api.ts)
VITE_QUBITRO_API_TOKEN=
